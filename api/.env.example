# API
APP_NAME=ViBoxSchool Project API
HOST_NAME=http://localhost
VERSIONING=/api/v1
PORT=3000

# Database (Supabase - via Session Pooler for IPv4)
DB_HOST=aws-0-[region].pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.[your-project-ref]
DB_PASSWORD=your-database-password
DB_NAME=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=30d

# Supabase Storage (private enrollment-documents bucket)
# Keep the service-role key in the API only; never use it in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional demo login. Keep disabled except in controlled demo environments.
DEMO_LOGIN_ENABLED=false
# Required only when running the demo-account seeder or enabling demo login.
VIBOX_DEMO_PASSWORD=replace-with-a-strong-demo-password